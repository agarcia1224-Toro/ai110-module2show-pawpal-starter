classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete()
        +mark_incomplete()
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Scheduler {
        +get_tasks(owner, include_completed)
        +filter_tasks(owner, pet_name, completed, as_of)
        +sort_by_time(tasks)
        +get_schedule(owner, include_completed)
        +mark_task_complete(pet, task, completed_on)
        +detect_conflicts(tasks)
        +format_schedule(owner)
        -_time_sort_key(value)
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks from
    Scheduler ..> Task : organizes
